# PlantShield AI: Backend Orchestration Layer Configuration
# Rename this file to '.env' and fill in your keys.

# 1. Orchestrator Server Config
PORT=5000

# 2. Local AI Service URL (FastAPI)
FASTAPI_AI_URL=http://127.0.0.1:8000

# 3. Google Gemini API Config
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash

# 4. AWS Telemetry Configuration
# Define AWS credentials and region to fetch from DynamoDB PlantShieldLatestState
AWS_REGION=us-east-1
DYNAMODB_TABLE_LATEST=PlantShieldLatestState
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID_HERE
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY_HERE
