# PlantShield AI: Gemini Advisory Module Configuration
# Rename this file to '.env' and paste your Google AI Studio API Key.

# 1. Google Gemini API Configuration
# Get your API Key here: https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# 2. Target Gemini Model
# Recommended models: 'gemini-1.5-flash' (fast & cost-efficient) or 'gemini-2.5-flash'
GEMINI_MODEL=gemini-1.5-flash
